# ============================================================
# FIREWALL — ENTERPRISE CYBERSECURITY ECOSYSTEM ENVIRONMENT CONFIG
# ============================================================

# Environment & Ports
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ============================================================
# SUPABASE CONFIGURATION (POSTGRESQL, AUTH, REALTIME, RLS)
# ============================================================
# 1. Project URL from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Secret Service Role Key (Keep secret! Used by API & Admin SOC)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Direct Database Connection String for Prisma ORM
# From Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?sslmode=require"

# ============================================================
# LOCAL REDIS & ENCRYPTION SECRETS
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Secrets (Minimum 256-bit high-entropy secret)
JWT_SECRET=super_secret_firewall_jwt_encryption_key_change_in_production_min32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_firewall_jwt_refresh_encryption_key_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# Two-Factor Authentication (TOTP / MFA)
MFA_APP_NAME="FIREWALL Security"
MFA_ISSUER="Firewall Cybersecurity"

# Encryption at Rest (AES-256-GCM Vault Key)
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=firewall-security-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@firewall-security-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Security Scanning & SOC Engines
ENABLE_THREAT_INTEL_FEEDS=true
SCAN_RATE_LIMIT_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
