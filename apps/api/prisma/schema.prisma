generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SOC_ANALYST
  SUPER_USER
  USER
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum ModuleStatus {
  SECURE
  WARNING
  CRITICAL
  SCANNING
  DISABLED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  fullName      String
  role          Role            @default(USER)
  avatarUrl     String?
  isMfaEnabled  Boolean         @default(false)
  mfaSecret     String?
  securityScore Int             @default(98)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  devices       Device[]
  alerts        SecurityAlert[]
  moduleStates  ModuleState[]
  scanHistories ScanHistory[]
  vaultItems    VaultItem[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  name       String
  type       String   // MOBILE, DESKTOP, TABLET, SERVER
  os         String
  ipAddress  String
  macAddress String?
  trustScore Int      @default(95)
  status     String   @default("ONLINE")
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model SecurityAlert {
  id           String        @id @default(uuid())
  userId       String
  title        String
  description  String
  severity     AlertSeverity @default(INFO)
  sourceModule String
  resolved     Boolean       @default(false)
  location     String?
  ipAddress    String?
  device       String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_alerts")
}

model ModuleState {
  id             String       @id @default(uuid())
  userId         String
  moduleId       String
  name           String
  status         ModuleStatus @default(SECURE)
  score          Int          @default(100)
  threatsBlocked Int          @default(0)
  lastScanTime   DateTime     @default(now())
  metadataJson   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("module_states")
}

model ScanHistory {
  id          String   @id @default(uuid())
  userId      String
  moduleId    String
  scanType    String
  status      String   @default("COMPLETED")
  score       Int      @default(100)
  issuesFound Int      @default(0)
  detailsJson String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scan_histories")
}

model VaultItem {
  id            String   @id @default(uuid())
  userId        String
  title         String
  category      String   // PASSWORD, NOTE, IDENTITY, CARD
  username      String?
  encryptedBlob String
  iv            String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_items")
}

model ThreatFeed {
  id          String   @id @default(uuid())
  indicator   String   @unique
  type        String   // IP, DOMAIN, HASH, URL
  threatLevel String   // LOW, MEDIUM, HIGH, CRITICAL
  description String
  reportedAt  DateTime @default(now())

  @@map("threat_feeds")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  ipAddress    String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
